@using Microsoft.Extensions.Localization
@inject IStringLocalizerFactory LocalizerFactory

@model HelaTico.Application.DTOs.ProductoDTO

@{
    var SharedLocalizer =
        LocalizerFactory.Create("Views.Shared.SharedResource", "HelaTico.Web");
    var ProductoLocalizer =
        LocalizerFactory.Create("Views.Producto.ProductoResource", "HelaTico.Web");

    ViewData["Title"] = ProductoLocalizer["ProdTituloEditar"];
}

<h1>@ProductoLocalizer["ProdTituloEditar"]</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        <form asp-action="Update" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="IdProducto" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">@ProductoLocalizer["ProdEtiquetaNombre"]</label>
                <input asp-for="Nombre" class="form-control" id="nombreInput" autocomplete="off" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
                <span id="nombreDuplicado" class="text-danger" style="display:none;">
                    @ProductoLocalizer["ProdNombreDuplicadoEditar"]
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">@ProductoLocalizer["ProdEtiquetaDescripcion"]</label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Precio" class="form-label">@ProductoLocalizer["ProdEtiquetaPrecio"]</label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" />
                </div>
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IdCategoria" class="form-label">@ProductoLocalizer["ProdEtiquetaCategoria"]</label>
                @Html.DropDownListFor(m => m.IdCategoria,
                         (SelectList)ViewBag.ListCategorias,
                         new { @class = "form-select" })
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">@ProductoLocalizer["ProdEtiquetaEstado"]</label>
                <div>
                    @foreach (var item in Html.GetEnumSelectList<HelaTico.Application.Enums.EstadoProducto>())
                    {
                        <div class="form-check form-check-inline">
                            <input type="radio"
                                   class="form-check-input"
                                   id="estado_@item.Value"
                                   name="@Html.NameFor(m => m.EstadoProductoId)"
                                   value="@item.Value"
                            @(Model.EstadoProductoId.ToString() == item.Value ? "checked" : "") />
                            <label class="form-check-label" for="estado_@item.Value">@item.Text</label>
                        </div>
                    }
                </div>
                <span asp-validation-for="EstadoProductoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">@ProductoLocalizer["ProdEtiquetaIngredientesForm"]</label>
                <small class="text-muted d-block mb-2">@ProductoLocalizer["ProdAyudaIngredientes"]</small>
                <div class="border rounded p-3">
                    <div class="row">
                        @{
                            var ingredientesUpdate = ((MultiSelectList)ViewBag.ListIngredientes).ToList();
                            var mitadUpdate = (int)Math.Ceiling(ingredientesUpdate.Count / 2.0);
                            var col1Update = ingredientesUpdate.Take(mitadUpdate);
                            var col2Update = ingredientesUpdate.Skip(mitadUpdate);
                        }
                        <div class="col-md-6">
                            @foreach (var item in col1Update)
                            {
                                <div class="form-check">
                                    <input type="checkbox"
                                           name="IdIngrediente"
                                           value="@item.Value"
                                           class="form-check-input"
                                           id="ing_@item.Value"
                                           checked="@item.Selected" />
                                    <label class="form-check-label" for="ing_@item.Value">@item.Text</label>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            @foreach (var item in col2Update)
                            {
                                <div class="form-check">
                                    <input type="checkbox"
                                           name="IdIngrediente"
                                           value="@item.Value"
                                           class="form-check-input"
                                           id="ing_@item.Value"
                                           checked="@item.Selected" />
                                    <label class="form-check-label" for="ing_@item.Value">@item.Text</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <span asp-validation-for="IdIngrediente" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">@ProductoLocalizer["ProdEtiquetaImagen"]</label>
                @if (Model.Imagen != null)
                {
                    <div class="mb-2">
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagen)" alt="Imagen actual" style="max-width:200px; border-radius:8px;" />
                        <small class="text-muted d-block">@ProductoLocalizer["ProdImagenActualNota"]</small>
                    </div>
                }
                <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*" onchange="previsualizarImagen(this)" />
                <div class="mt-2">
                    <img id="previewImagen" src="#" alt="Vista previa nueva" style="max-width:200px; display:none; border-radius:8px;" />
                </div>
                <span asp-validation-for="Imagen" class="text-danger"></span>
            </div>

            <div class="btn-group mt-3" role="group">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> @ProductoLocalizer["ProdBtnGuardarCambios"]
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> @ProductoLocalizer["ProdBtnCancelar"]
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previsualizarImagen(input) {
            const preview = document.getElementById('previewImagen');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        const idProductoActual = @Model.IdProducto;
        const nombreInput = document.getElementById('nombreInput');
        const avisoDuplicado = document.getElementById('nombreDuplicado');
        let timeoutNombre;

        nombreInput.addEventListener('input', function () {
            clearTimeout(timeoutNombre);
            const nombre = this.value.trim();
            if (nombre.length < 3) {
                avisoDuplicado.style.display = 'none';
                return;
            }
            timeoutNombre = setTimeout(async () => {
                const respuesta = await fetch(`/Producto/ExisteNombre?nombre=${encodeURIComponent(nombre)}&id=${idProductoActual}`);
                const existe = await respuesta.json();
                avisoDuplicado.style.display = existe ? 'block' : 'none';
            }, 400);
        });
    </script>
}