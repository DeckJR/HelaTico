@using Microsoft.Extensions.Localization
@inject IStringLocalizerFactory LocalizerFactory

@model IEnumerable<HelaTico.Application.DTOs.ProductoDTO>

@{
    var SharedLocalizer =
        LocalizerFactory.Create("Views.Shared.SharedResource", "HelaTico.Web");
    var ProductoLocalizer =
        LocalizerFactory.Create("Views.Producto.ProductoResource", "HelaTico.Web");
}

<h1>@ProductoLocalizer["ProdTitulo"]</h1>

<p>
    <a asp-action="Create" class="btn btn-success">@SharedLocalizer["BtnCreateNew"]</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@ProductoLocalizer["ProdColImagen"]</th>
            <th>@ProductoLocalizer["ProdColNombre"]</th>
            <th>@ProductoLocalizer["ProdColCategoria"]</th>
            <th>@ProductoLocalizer["ProdColPrecio"]</th>
            <th>@ProductoLocalizer["ProdColAcciones"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Imagen != null)
                    {
                        var base64 = Convert.ToBase64String(item.Imagen);
                        var imgSrc = $"data:image/png;base64,{base64}";
                        <img src="@imgSrc"
                             style="width:80px; height:80px; object-fit:cover; border-radius:8px;" />
                    }
                    else
                    {
                        <img src="/images/no-image.png"
                             style="width:80px; height:80px; object-fit:cover; border-radius:8px;" />
                    }
                </td>
                <td>@item.Nombre</td>
                <td>@item.Categoria</td>
                <td>₡@item.Precio.ToString("N2")</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.IdProducto"
                       class="btn btn-primary">
                        @SharedLocalizer["BtnViewDetails"]
                    </a>
                    <a asp-action="Update"
                       asp-route-id="@item.IdProducto"
                       class="btn btn-warning">
                        @SharedLocalizer["BtnEdit"]
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>