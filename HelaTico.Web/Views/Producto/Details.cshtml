@using Microsoft.Extensions.Localization
@inject IStringLocalizerFactory LocalizerFactory

@model HelaTico.Application.DTOs.ProductoDTO

@{
    var SharedLocalizer =
        LocalizerFactory.Create("Views.Shared.SharedResource", "HelaTico.Web");
    var ProductoLocalizer =
        LocalizerFactory.Create("Views.Producto.ProductoResource", "HelaTico.Web");

    ViewData["Title"] = ProductoLocalizer["ProdTituloDetalle"];
}

<h1>@ProductoLocalizer["ProdTituloDetalle"]</h1>

<div class="row">
    <div class="col">
        @if (Model.Imagen != null)
        {
            <img class="card-img-top"
                 style="max-width:460px;"
                 src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagen)"
                 alt="Imagen" />
        }
    </div>

    <div class="col">
        <h4>@ProductoLocalizer["ProdEtiquetaProducto"]</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">@ProductoLocalizer["ProdEtiquetaNombre"]</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">@ProductoLocalizer["ProdEtiquetaDescripcion"]</dt>
            <dd class="col-sm-9">@Model.Descripcion</dd>

            <dt class="col-sm-3">@ProductoLocalizer["ProdEtiquetaPrecio"]</dt>
            <dd class="col-sm-9">₡@Model.Precio.ToString("N2")</dd>

            <dt class="col-sm-3">@ProductoLocalizer["ProdEtiquetaCategoria"]</dt>
            <dd class="col-sm-9">@Model.Categoria</dd>

            <dt class="col-sm-3">@ProductoLocalizer["ProdEtiquetaEstado"]</dt>
            <dd class="col-sm-9">@Model.EstadoProducto</dd>
        </dl>

        <div>
            <h5>@ProductoLocalizer["ProdEtiquetaIngredientes"]</h5>
            <ul>
                @foreach (var item in Model.Ingredientes)
                {
                    <li>@item</li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="btn-group mt-3" role="group">
    <a asp-action="Update" asp-route-id="@Model.IdProducto" class="btn btn-warning">
        @SharedLocalizer["BtnEdit"]
    </a>

    <button type="button" class="btn btn-secondary" onclick="history.back()">
        @ProductoLocalizer["ProdBtnVolver"]
    </button>
</div>