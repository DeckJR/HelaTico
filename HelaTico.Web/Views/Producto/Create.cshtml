@model HelaTico.Application.DTOs.ProductoDTO
@{
    ViewData["Title"] = "Crear Producto";
}

<h1>Crear Producto</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Helado de vainilla" id="nombreInput" autocomplete="off" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
                <span id="nombreDuplicado" class="text-danger" style="display:none;">
                    Ya existe un producto con este nombre.
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" placeholder="Describe el producto" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Precio" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                </div>
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IdCategoria" class="form-label">Categoría</label>
                @Html.DropDownListFor(m => m.IdCategoria,
                         (SelectList)ViewBag.ListCategorias,
                         "-- Seleccione --",
                         new { @class = "form-select" })
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Estado</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="Estado" id="estadoDisponible"
                           value="1" checked />
                    <label class="form-check-label" for="estadoDisponible">
                        Disponible
                    </label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="Estado" id="estadoNoDisponible"
                           value="2" />
                    <label class="form-check-label" for="estadoNoDisponible">
                        No Disponible
                    </label>
                </div>
                <span asp-validation-for="EstadoProducto" class="text-danger d-block"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Ingredientes</label>
                <small class="text-muted d-block mb-2">Seleccione los ingredientes de este producto.</small>
                <div class="border rounded p-3">
                    <div class="row">
                        @{
                            var ingredientesCreate = ((MultiSelectList)ViewBag.ListIngredientes).ToList();
                            var mitadCreate = (int)Math.Ceiling(ingredientesCreate.Count / 2.0);
                            var col1Create = ingredientesCreate.Take(mitadCreate);
                            var col2Create = ingredientesCreate.Skip(mitadCreate);
                        }
                        <div class="col-md-6">
                            @foreach (var item in col1Create)
                            {
                                <div class="form-check">
                                    <input type="checkbox"
                                           name="IdIngrediente"
                                           value="@item.Value"
                                           class="form-check-input"
                                           id="ing_@item.Value"
                                           checked="@item.Selected" />
                                    <label class="form-check-label" for="ing_@item.Value">@item.Text</label>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            @foreach (var item in col2Create)
                            {
                                <div class="form-check">
                                    <input type="checkbox"
                                           name="IdIngrediente"
                                           value="@item.Value"
                                           class="form-check-input"
                                           id="ing_@item.Value"
                                           checked="@item.Selected" />
                                    <label class="form-check-label" for="ing_@item.Value">@item.Text</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <span asp-validation-for="IdIngrediente" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Imagen</label>
                <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*" onchange="previsualizarImagen(this)" />
                <div class="mt-2">
                    <img id="previewImagen" src="#" alt="Vista previa" style="max-width:200px; display:none; border-radius:8px;" />
                </div>
                <span asp-validation-for="Imagen" class="text-danger"></span>
            </div>

            <div class="btn-group mt-3" role="group">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> Guardar
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previsualizarImagen(input) {
            const preview = document.getElementById('previewImagen');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        const nombreInput = document.getElementById('nombreInput');
        const avisoDuplicado = document.getElementById('nombreDuplicado');
        let timeoutNombre;

        nombreInput.addEventListener('input', function () {
            clearTimeout(timeoutNombre);
            const nombre = this.value.trim();
            if (nombre.length < 3) {
                avisoDuplicado.style.display = 'none';
                return;
            }
            timeoutNombre = setTimeout(async () => {
                const respuesta = await fetch(`/Producto/ExisteNombre?nombre=${encodeURIComponent(nombre)}`);
                const existe = await respuesta.json();
                avisoDuplicado.style.display = existe ? 'block' : 'none';
            }, 400);
        });
    </script>
}