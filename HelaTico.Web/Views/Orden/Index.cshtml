@model List<HelaTico.Application.DTOs.EstacionProcesoDTO>

@{
    ViewData["Title"] = Localizer["ViewTitle"];
}

<div class="container mt-4">
    <h2 class="mb-4">@Localizer["Heading"]</h2>

    <div class="row g-4">
        @foreach (var estacion in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@estacion.Descripcion</h5>
                        <hr />
                        <div class="d-flex justify-content-between mb-2">
                            <span>@Localizer["LblPendientes"]</span>
                            <span class="badge bg-warning text-dark">@estacion.OrdenesPendientes</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>@Localizer["LblEnProceso"]</span>
                            <span class="badge bg-primary">@estacion.OrdenesEnProceso</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-controller="Orden" asp-action="Estacion" asp-route-id="@estacion.IdEstacion" class="btn btn-primary w-100">
                            @Localizer["BtnVerEstacion"]
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>