@model IEnumerable<HelaTico.Application.DTOs.PreparacionDTO>
@{
    ViewData["Title"] = "Procesos de Preparación";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Procesos de Preparación</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nuevo Proceso
    </a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad de Pasos</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreProducto</td>
                <td>@item.CantidadPasos</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details"
                           asp-route-id="@item.IdProducto"
                           class="btn btn-primary btn-sm">
                            <i class="bi bi-eye"></i> Detalle
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@item.IdProducto"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
