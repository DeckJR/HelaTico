@model IEnumerable<HelaTico.Application.DTOs.PreparacionDTO>
@{
    ViewData["Title"] = Localizer["ViewTitle"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["ViewTitle"]</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> @Localizer["BtnNuevoProceso"]
    </a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Localizer["ColProducto"]</th>
            <th>@Localizer["ColCantidadPasos"]</th>
            <th>@Localizer["ColAcciones"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreProducto</td>
                <td>@item.CantidadPasos</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details"
                           asp-route-id="@item.IdProducto"
                           class="btn btn-primary btn-sm">
                            <i class="bi bi-eye"></i> @Localizer["BtnDetalle"]
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@item.IdProducto"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> @Localizer["BtnEditar"]
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>