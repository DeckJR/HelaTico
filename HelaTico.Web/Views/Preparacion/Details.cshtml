@model HelaTico.Application.DTOs.PreparacionDTO
@{
    ViewData["Title"] = Localizer["ViewTitle"];
}
<h1>@Localizer["ViewTitle"]</h1>
<dl class="row">
    <dt class="col-sm-3">@Localizer["LblProducto"]</dt>
    <dd class="col-sm-9">@Model.NombreProducto</dd>

    <dt class="col-sm-3">@Localizer["LblCantidadPasos"]</dt>
    <dd class="col-sm-9">@Model.CantidadPasos</dd>
</dl>

<h5>@Localizer["HeadingEstaciones"]</h5>
<table class="table">
    <thead>
        <tr>
            <th>@Localizer["ColOrden"]</th>
            <th>@Localizer["ColEstacion"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var paso in Model.Pasos)
        {
            <tr>
                <td>@paso.Orden</td>
                <td>@paso.NombreEstacion</td>
            </tr>
        }
    </tbody>
</table>

<button type="button" class="btn btn-secondary" onclick="history.back()">
    @Localizer["BtnVolver"]
</button>