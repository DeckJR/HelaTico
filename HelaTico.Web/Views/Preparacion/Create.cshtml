@model HelaTico.Application.DTOs.PreparacionDTO
@using HelaTico.Application.DTOs
@{
    ViewData["Title"] = Localizer["ViewTitle"];
    var listaEstaciones = (IEnumerable<EstacionDTO>)ViewBag.ListaEstaciones;
    var productosSinProceso = (IEnumerable<ProductoDTO>)ViewBag.ProductosSinProceso;
    const int ESTACION_FINAL_ID = 5;
    var estacionFinal = listaEstaciones.FirstOrDefault(e => e.IdEstacion == ESTACION_FINAL_ID);
}

<h1>@Localizer["ViewTitle"]</h1>
<hr />

<div class="row">
    <div class="col-md-10">
        <form asp-action="Create" method="post" id="formPreparacion">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">@Localizer["LblProducto"]</label>
                <select asp-for="IdProducto" class="form-select">
                    <option value="0">@Localizer["OptSeleccioneProducto"]</option>
                    @foreach (var p in productosSinProceso)
                    {
                        <option value="@p.IdProducto">@p.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdProducto" class="text-danger"></span>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold">@Localizer["CardAgregarEstacion"]</div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label">@Localizer["LblEstacion"]</label>
                            <select id="selectEstacion" class="form-select">
                                <option value="0">@Localizer["OptSeleccione"]</option>
                                @foreach (var e in listaEstaciones.Where(e => e.IdEstacion != ESTACION_FINAL_ID))
                                {
                                    <option value="@e.IdEstacion" data-nombre="@e.Descripcion">
                                        @e.Descripcion
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-success w-100"
                                    onclick="agregarEstacion()">
                                <i class="bi bi-plus-circle"></i> @Localizer["BtnAgregar"]
                            </button>
                        </div>
                    </div>
                    <div id="errorAgregar" class="text-danger mt-2" style="display:none;"></div>
                </div>
            </div>

            <h5>@Localizer["HeadingProcesoActual"]</h5>
            <small class="text-muted d-block mb-2">
                @Localizer["HintProceso"]
            </small>
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px;">@Localizer["ColPaso"]</th>
                        <th>@Localizer["ColEstacion"]</th>
                        <th style="width:100px;">@Localizer["ColAccion"]</th>
                    </tr>
                </thead>
                <tbody id="bodyEstaciones">
                </tbody>
                <tfoot>
                    <tr class="table-warning">
                        <td class="text-center fw-bold">
                            <i class="bi bi-lock-fill"></i>
                        </td>
                        <td>
                            @(estacionFinal?.Descripcion ?? Localizer["LblEstacionFinalDefault"].Value)
                            <small class="text-muted">@Localizer["HintSiempreUltimo"]</small>
                        </td>
                        <td class="text-center text-muted">—</td>
                    </tr>
                </tfoot>
            </table>

            <div id="hiddenInputs"></div>

            <div class="btn-group mt-3" role="group">
                <button type="submit" class="btn btn-success" onclick="return prepararEnvio()">
                    <i class="bi bi-save"></i> @Localizer["BtnGuardar"]
                </button>
                <button type="button" class="btn btn-secondary" onclick="history.back()">
                    <i class="bi bi-arrow-left"></i> @Localizer["BtnCancelar"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const ESTACION_FINAL_ID = @ESTACION_FINAL_ID;
        let pasos = [];

        const i18nPrep = {
            seleccioneEstacion: '@Localizer["ErrSeleccioneEstacion"]',
            estacionYaAgregada: '@Localizer["ErrEstacionYaAgregada"]',
            debeAgregarEstacion: '@Localizer["ErrDebeAgregarEstacion"]'
        };

        function mostrarError(msg) {
            const el = document.getElementById('errorAgregar');
            el.textContent = msg;
            el.style.display = msg ? 'block' : 'none';
        }

        function agregarEstacion() {
            mostrarError('');
            const sel    = document.getElementById('selectEstacion');
            const id     = parseInt(sel.value);
            const nombre = sel.options[sel.selectedIndex]?.dataset.nombre ?? '';

            if (!id || id === 0) {
                mostrarError(i18nPrep.seleccioneEstacion); return;
            }
            if (pasos.find(p => p.idEstacion === id)) {
                mostrarError(i18nPrep.estacionYaAgregada); return;
            }

            pasos.push({ idEstacion: id, nombre });
            renderTabla();
            actualizarDropdown();
            sel.value = '0';
        }

        function eliminarEstacion(idEstacion) {
            pasos = pasos.filter(p => p.idEstacion !== idEstacion);
            renderTabla();
            actualizarDropdown();
        }

        function renderTabla() {
            const tbody = document.getElementById('bodyEstaciones');
            tbody.innerHTML = '';

            pasos.forEach((p, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-center fw-bold">${index + 1}</td>
                    <td>${p.nombre}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm"
                                onclick="eliminarEstacion(${p.idEstacion})">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>`;
                tbody.appendChild(tr);
            });
        }

        function actualizarDropdown() {
            const sel = document.getElementById('selectEstacion');
            const idsAgregados = new Set(pasos.map(p => p.idEstacion));

            Array.from(sel.options).forEach(opt => {
                const id = parseInt(opt.value);
                if (id && id !== ESTACION_FINAL_ID) {
                    opt.disabled    = idsAgregados.has(id);
                    opt.style.color = idsAgregados.has(id) ? '#aaa' : '';
                }
            });
        }

        function prepararEnvio() {
            if (pasos.length === 0) {
                mostrarError(i18nPrep.debeAgregarEstacion);
                return false;
            }

            const todosLosPasos = [
                ...pasos.map((p, i) => ({ idEstacion: p.idEstacion, orden: i + 1 })),
                { idEstacion: ESTACION_FINAL_ID, orden: pasos.length + 1 }
            ];

            const container = document.getElementById('hiddenInputs');
            container.innerHTML = '';

            todosLosPasos.forEach(p => {
                const inputId        = document.createElement('input');
                inputId.type         = 'hidden';
                inputId.name         = 'estacionIds';
                inputId.value        = p.idEstacion;
                container.appendChild(inputId);

                const inputOrden     = document.createElement('input');
                inputOrden.type      = 'hidden';
                inputOrden.name      = 'ordenes';
                inputOrden.value     = p.orden;
                container.appendChild(inputOrden);
            });

            return true;
        }
    </script>
}