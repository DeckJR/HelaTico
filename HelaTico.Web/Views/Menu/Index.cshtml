@model IEnumerable<HelaTico.Application.DTOs.MenuDTO>
<h1>@Localizer["Heading"]</h1>

<p>
    <a asp-action="Create" class="btn btn-success">@Localizer["BtnCrearNuevo"]</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Localizer["ColNombre"]</th>
            <th>@Localizer["ColFechaInicio"]</th>
            <th>@Localizer["ColFechaFinal"]</th>
            <th>@Localizer["ColEstado"]</th>
            <th>@Localizer["ColProductos"]</th>
            <th>@Localizer["ColCombos"]</th>
            <th>@Localizer["ColAcciones"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.FechaInicio.ToShortDateString()</td>
                <td>@item.FechaFinal.ToShortDateString()</td>
                <td>@item.EstadoMenu</td>
                <td>
                    @foreach (var p in item.Productos.Take(3))
                    {
                        <div>@p.Nombre</div>
                    }
                </td>
                <td>
                    @foreach (var c in item.Combos.Take(3))
                    {
                        <div>@c.Nombre</div>
                    }
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.IdMenu"
                       class="btn btn-info">
                        @Localizer["BtnDetalles"]
                    </a>
                    <a asp-action="Update"
                       asp-route-id="@item.IdMenu"
                       class="btn btn-warning">
                        @Localizer["BtnEditar"]
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>