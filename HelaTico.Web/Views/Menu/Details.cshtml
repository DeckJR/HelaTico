@model HelaTico.Application.DTOs.MenuDTO

<h2>@Model.Nombre</h2>

<p><strong>@Localizer["LblFechaInicio"]</strong> @Model.FechaInicio.ToShortDateString()</p>
<p><strong>@Localizer["LblFechaFinal"]</strong> @Model.FechaFinal.ToShortDateString()</p>
<p><strong>@Localizer["LblEstado"]</strong> @Model.EstadoMenu</p>

<div class="row">

    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h4>@Localizer["HeaderCombos"]</h4>
            </div>

            <div class="card-body">
                @if (Model.Combos != null && Model.Combos.Any())
                {
                    <div class="row">
                        @foreach (var combo in Model.Combos)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100 shadow-sm">

                                    @if (combo.Imagen != null && combo.Imagen.Length > 0)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(combo.Imagen)"
                                             class="card-img-top"
                                             style="height:200px; object-fit:cover;"
                                             alt="Imagen combo" />
                                    }
                                    else
                                    {
                                        <img src="/images/default.png"
                                             class="card-img-top"
                                             style="height:200px; object-fit:cover;"
                                             alt="Sin imagen" />
                                    }

                                    <div class="card-body text-center">
                                        <h5 class="card-title">@combo.Nombre</h5>

                                        <p class="text-success fw-bold">
                                            ₡@combo.Precio.ToString("N2")
                                        </p>
                                    </div>

                                    <div class="card-footer text-center">
                                        <button class="btn btn-success btn-sm">
                                            @Localizer["BtnAgregar"]
                                        </button>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>@Localizer["MsgSinCombos"]</p>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4>@Localizer["HeaderProductos"]</h4>
            </div>

            <div class="card-body">
                @if (Model.Productos != null && Model.Productos.Any())
                {
                    <div class="row">
                        @foreach (var producto in Model.Productos)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100 shadow-sm">

                                    @if (producto.Imagen != null && producto.Imagen.Length > 0)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(producto.Imagen)"
                                             class="card-img-top"
                                             style="height:200px; object-fit:cover;"
                                             alt="Imagen producto" />
                                    }
                                    else
                                    {
                                        <img src="/images/default.png"
                                             class="card-img-top"
                                             style="height:200px; object-fit:cover;"
                                             alt="Sin imagen" />
                                    }

                                    <div class="card-body">
                                        <h5 class="card-title">@producto.Nombre</h5>

                                        <p class="card-text">
                                            <strong>@Localizer["LblCategoria"]</strong> @producto.Categoria
                                        </p>

                                        <p class="text-success fw-bold">
                                            ₡@producto.Precio.ToString("N2")
                                        </p>
                                    </div>

                                    <div class="card-footer text-center">
                                        <button class="btn btn-primary btn-sm">
                                            @Localizer["BtnAgregar"]
                                        </button>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>@Localizer["MsgSinProductos"]</p>
                }
            </div>
        </div>
    </div>

</div>