@model HelaTico.Application.DTOs.MenuDTO?
@{
    ViewData["Title"] = Localizer["ViewTitle"];
}

<h2 class="text-center mb-4" style="color: #0a1f44; font-weight: bold;">
    @Localizer["ViewTitle"]
</h2>

@Html.AntiForgeryToken()

@if (Model == null)
{
    <div class="text-center mt-5">
        <i class="bi bi-calendar-x" style="font-size:3rem; color:#aaa;"></i>
        <p class="mt-3 text-muted fs-5">@Localizer["MsgSinMenu"]</p>
    </div>
}
else
{
    <div class="container">
        <div class="mb-5 p-4 rounded"
             style="background: linear-gradient(to right, #ffffff, #e6f0ff);
                    box-shadow: 0 5px 15px rgba(0,0,0,0.2);">

            <h3 class="text-primary">@Model.Nombre</h3>
            <p class="text-muted">
                @Localizer["LblDisponible"]
                <strong>@Model.FechaInicio.ToShortDateString()</strong> -
                <strong>@Model.FechaFinal.ToShortDateString()</strong>
            </p>

            @* ── Productos agrupados por categoría ── *@
            @if (Model.Productos != null && Model.Productos.Any())
            {
                var grupos = Model.Productos.GroupBy(p => p.Categoria);
                foreach (var grupo in grupos)
                {
                    <h5 class="mt-4 border-bottom pb-2">
                        🍦 @grupo.Key
                    </h5>
                    <div class="row">
                        @foreach (var p in grupo)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="carta-item"
                                     style="background:white; padding:15px; border-radius:15px;
                                            box-shadow:0 3px 10px rgba(0,0,0,0.1); text-align:center; cursor:pointer;"
                                     data-bs-toggle="modal"
                                     data-bs-target="#modalItem"
                                     data-tipo="Producto"
                                     data-id="@p.IdProducto"
                                     data-nombre="@p.Nombre"
                                     data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-descripcion="@p.Descripcion"
                                     data-imagen="@(p.Imagen != null && p.Imagen.Length > 0 ? "data:image/png;base64," + Convert.ToBase64String(p.Imagen) : "/images/no-image.png")">
                                    @if (p.Imagen != null && p.Imagen.Length > 0)
                                    {
                                        <img src="data:image/png;base64,@Convert.ToBase64String(p.Imagen)"
                                             style="width:100%; height:150px; object-fit:cover;
                                                    border-radius:10px; margin-bottom:10px;" />
                                    }
                                    else
                                    {
                                        <img src="/images/no-image.png"
                                             style="width:100%; height:150px; object-fit:cover;
                                                    border-radius:10px; margin-bottom:10px;" />
                                    }
                                    <h6 class="text-primary">@p.Nombre</h6>
                                    <p>₡@p.Precio.ToString("N2")</p>
                                    <p class="small text-muted">@p.Descripcion</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-muted mt-3">@Localizer["MsgSinProductosAsignados"]</p>
            }

            @* ── Combos ── *@
            <h5 class="mt-4 border-bottom pb-2">@Localizer["HeaderCombos"]</h5>
            @if (Model.Combos != null && Model.Combos.Any())
            {
                <div class="row">
                    @foreach (var c in Model.Combos)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="carta-item"
                                 style="background:white; padding:15px; border-radius:15px;
                                        box-shadow:0 3px 10px rgba(0,0,0,0.1); text-align:center; cursor:pointer;"
                                 data-bs-toggle="modal"
                                 data-bs-target="#modalItem"
                                 data-tipo="Combo"
                                 data-id="@c.IdCombo"
                                 data-nombre="@c.Nombre"
                                 data-precio="@c.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-descripcion="@c.Descripcion"
                                 data-imagen="@(c.Imagen != null && c.Imagen.Length > 0 ? "data:image/png;base64," + Convert.ToBase64String(c.Imagen) : "/images/no-image.png")">
                                @if (c.Imagen != null && c.Imagen.Length > 0)
                                {
                                    <img src="data:image/png;base64,@Convert.ToBase64String(c.Imagen)"
                                         style="width:100%; height:150px; object-fit:cover;
                                                border-radius:10px; margin-bottom:10px;" />
                                }
                                else
                                {
                                    <img src="/images/no-image.png"
                                         style="width:100%; height:150px; object-fit:cover;
                                                border-radius:10px; margin-bottom:10px;" />
                                }
                                <h6 class="text-success">@c.Nombre</h6>
                                <p>₡@c.Precio.ToString("N2")</p>
                                <p class="small text-muted">@c.Descripcion</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">@Localizer["MsgSinCombosAsignados"]</p>
            }

        </div>
    </div>
}

@* ── Modal de detalle + agregar al carrito ── *@
<div class="modal fade" id="modalItem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalItemNombre"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalItemImagen" src="" style="width:100%; max-height:220px; object-fit:cover; border-radius:10px;" />
                <p id="modalItemDescripcion" class="text-muted mt-3"></p>
                <h5 id="modalItemPrecio" class="text-success"></h5>

                <div class="d-flex justify-content-center align-items-center mt-3">
                    <button type="button" class="btn btn-outline-secondary" id="btnRestar">-</button>
                    <input type="number" id="inputCantidad" class="form-control text-center mx-2" style="width:70px;" value="1" min="1" />
                    <button type="button" class="btn btn-outline-secondary" id="btnSumar">+</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnAgregarCarrito">
                    <i class="bi bi-cart-plus"></i> Agregar al carrito
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEl = document.getElementById('modalItem');
        const modalNombre = document.getElementById('modalItemNombre');
        const modalImagen = document.getElementById('modalItemImagen');
        const modalDescripcion = document.getElementById('modalItemDescripcion');
        const modalPrecio = document.getElementById('modalItemPrecio');
        const inputCantidad = document.getElementById('inputCantidad');
        const btnAgregarCarrito = document.getElementById('btnAgregarCarrito');

        let itemActual = null;

        modalEl.addEventListener('show.bs.modal', function (event) {
            const card = event.relatedTarget;

            itemActual = {
                tipo: card.dataset.tipo,
                id: card.dataset.id,
                nombre: card.dataset.nombre,
                precio: card.dataset.precio
            };

            modalNombre.textContent = card.dataset.nombre;
            modalImagen.src = card.dataset.imagen;
            modalDescripcion.textContent = card.dataset.descripcion;
            modalPrecio.textContent = '₡' + Number(card.dataset.precio).toLocaleString('es-CR', { minimumFractionDigits: 2 });
            inputCantidad.value = 1;
        });

        document.getElementById('btnSumar').addEventListener('click', () => {
            inputCantidad.value = parseInt(inputCantidad.value) + 1;
        });

        document.getElementById('btnRestar').addEventListener('click', () => {
            const actual = parseInt(inputCantidad.value);
            if (actual > 1) inputCantidad.value = actual - 1;
        });

        btnAgregarCarrito.addEventListener('click', async () => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const formData = new URLSearchParams();
            formData.append('tipo', itemActual.tipo);
            formData.append('id', itemActual.id);
            formData.append('nombre', itemActual.nombre);
            formData.append('precio', itemActual.precio);
            formData.append('cantidad', inputCantidad.value);
            formData.append('imagenUrl', modalImagen.src);
            if (token) formData.append('__RequestVerificationToken', token);

            const response = await fetch('/Carrito/Agregar', { method: 'POST', body: formData });
            const data = await response.json();

            if (data.exito) {
                actualizarBadgeCarrito(data.cantidadTotal);
                bootstrap.Modal.getInstance(modalEl).hide();
            }
        });

        function actualizarBadgeCarrito(cantidad) {
            const badge = document.getElementById('badgeCarrito');
            if (badge) badge.textContent = cantidad;
        }
    </script>
}