@model HelaTico.Application.DTOs.MenuDTO
@{
    ViewData["Title"] = Localizer["ViewTitle"];
}

<div class="d-flex justify-content-between align-items-center">
    <h1>@Localizer["ViewTitle"]</h1>
</div>
<hr />

<div class="row">
    <div class="col-md-8">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        <form asp-action="Create" method="post" id="formMenu">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="@Localizer["PlaceholderNombre"]" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="FechaInicio" class="form-label"></label>
                    <input asp-for="FechaInicio" type="date" class="form-control" id="fechaInicio" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaFinal" class="form-label"></label>
                    <input asp-for="FechaFinal" type="date" class="form-control" id="fechaFinal" />
                    <span asp-validation-for="FechaFinal" class="text-danger"></span>
                </div>
            </div>
            <span id="errorFechas" class="text-danger mb-3" style="display:none;">
                @Localizer["ErrorFechas"]
            </span>

            <div class="mb-3">
                <label class="form-label d-block">@Localizer["LblEstado"]</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="Estado" id="estadoDisponible"
                           value="1" checked />
                    <label class="form-check-label" for="estadoDisponible">
                        @Localizer["EstadoDisponible"]
                    </label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="Estado" id="estadoNoDisponible"
                           value="2" />
                    <label class="form-check-label" for="estadoNoDisponible">
                        @Localizer["EstadoNoDisponible"]
                    </label>
                </div>
                <span asp-validation-for="EstadoMenu" class="text-danger d-block"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">@Localizer["LblProductosIncluidos"]</label>
                <small class="text-muted d-block mb-2">
                    @Localizer["HintProductos"]
                </small>
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px;">@Localizer["ColIncluir"]</th>
                            <th>@Localizer["ColProducto"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in (MultiSelectList)ViewBag.ListProductos)
                        {
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox"
                                           name="IdProducto"
                                           value="@item.Value"
                                           class="form-check-input"
                                           checked="@item.Selected" />
                                </td>
                                <td>@item.Text</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <span asp-validation-for="IdProducto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">@Localizer["LblCombosIncluidos"]</label>
                <small class="text-muted d-block mb-2">
                    @Localizer["HintCombos"]
                </small>
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px;">@Localizer["ColIncluir"]</th>
                            <th>@Localizer["ColCombo"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in (MultiSelectList)ViewBag.ListCombos)
                        {
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox"
                                           name="IdCombo"
                                           value="@item.Value"
                                           class="form-check-input"
                                           checked="@item.Selected" />
                                </td>
                                <td>@item.Text</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <span asp-validation-for="IdCombo" class="text-danger"></span>
            </div>

            <div class="btn-group mt-3" role="group">
                <button type="button" class="btn btn-secondary" onclick="history.back()">
                    @Localizer["BtnVolver"]
                </button>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> @Localizer["BtnGuardarCambios"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('formMenu').addEventListener('submit', function (e) {
            const inicio = document.getElementById('fechaInicio').value;
            const final = document.getElementById('fechaFinal').value;
            const errorFechas = document.getElementById('errorFechas');
            if (inicio && final && inicio > final) {
                e.preventDefault();
                errorFechas.style.display = 'block';
            } else {
                errorFechas.style.display = 'none';
            }
        });
    </script>
}