@{
    ViewData["Title"] = Localizer["Heading"];
}
<div class="text-center mx-auto py-4 px-2 px-md-4" style="max-width:900px;">
    <h1 class="fw-bold mb-4" style="letter-spacing:1px;">
        @Localizer["Heading"]
    </h1>
    <p class="mb-4" style="font-size:1.05rem;">
        @Localizer["Parrafo1"]
    </p>
    <p class="mb-4" style="font-size:1.05rem;">
        @Localizer["Parrafo2"]
    </p>
    <p class="mb-4" style="font-size:1.05rem;">
        @Localizer["Parrafo3"]
    </p>
    <a asp-controller="Producto" asp-action="ProductoCards"
       class="btn rounded-pill px-5 py-2 mt-2"
       style="background-color:#82ba54; color:#fff; font-weight:600;">
        @Localizer["BtnVerProductos"]
    </a>

</div>