@model IEnumerable<HelaTico.Application.DTOs.ComboDTO>
@{
    ViewData["Title"] = "Mantenimiento de Combos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Combos</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nuevo Combo
    </a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th># Combo</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Productos</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdCombo</td>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td>₡@item.Precio.ToString("N2")</td>
                <td>
                    <span class="badge @(item.EstadoCombo == "Disponible" ? "bg-success" : "bg-secondary")">
                        @item.EstadoCombo
                    </span>
                </td>
                <td>@item.CantidadProductos</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details"
                           asp-route-id="@item.IdCombo"
                           class="btn btn-primary btn-sm">
                            <i class="bi bi-eye"></i> Detalle
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@item.IdCombo"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                onclick="confirmarEliminar(@item.IdCombo, '@item.Nombre')">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </div>

                    <form id="formEliminar_@item.IdCombo"
                          asp-action="Delete"
                          asp-route-id="@item.IdCombo"
                          method="post"
                          style="display:none;">
                        @Html.AntiForgeryToken()
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmarEliminar(id, nombre) {
            Swal.fire({
                title: '¿Eliminar combo?',
                html: `El combo <strong>${nombre}</strong> pasará a estado <strong>No Disponible</strong>.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#c3342d',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`formEliminar_${id}`).submit();
                }
            });
        }
    </script>
}
