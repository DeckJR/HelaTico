@model HelaTico.Application.DTOs.ComboDTO
@{
    ViewData["Title"] = Localizer["ViewTitle"];
}
<h1>@Localizer["ViewTitle"]</h1>
<div class="row">
    <div class="col">
        @if (Model.Imagen != null)
        {
            <img class="card-img-top"
                 style="max-width:460px;"
                 src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagen)"
                 alt="Imagen" />
        }
    </div>
    <div class="col">
        <h4>@Localizer["LblCombo"]</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Localizer["LblNombre"]</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">@Localizer["LblDescripcion"]</dt>
            <dd class="col-sm-9">@Model.Descripcion</dd>

            <dt class="col-sm-3">@Localizer["LblPrecio"]</dt>
            <dd class="col-sm-9">₡@Model.Precio.ToString("N2")</dd>

            <dt class="col-sm-3">@Localizer["LblEstado"]</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.EstadoCombo == "Disponible" ? "bg-success" : "bg-secondary")">
                    @Model.EstadoCombo
                </span>
            </dd>
        </dl>
        <div>
            <h5>@string.Format(Localizer["LblProductosIncluidos"].Value, Model.Productos.Count)</h5>
            <ul>
                @foreach (var producto in Model.Productos)
                {
                    <li>@producto.Cantidad x @producto.Nombre</li>
                }
            </ul>
        </div>
    </div>
</div>
<div class="btn-group mt-3" role="group">
    <button type="button" class="btn btn-secondary" onclick="history.back()">
        @Localizer["BtnVolver"]
    </button>
</div>