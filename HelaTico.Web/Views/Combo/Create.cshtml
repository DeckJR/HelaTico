@model HelaTico.Application.DTOs.ComboDTO
@using HelaTico.Application.DTOs
@{
    ViewData["Title"] = "Crear Combo";
    var listaProductos = (IEnumerable<ProductoDTO>)ViewBag.ListaProductos;
}

<h1>Crear Combo</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Combo Tropical" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" placeholder="Descripción del combo" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Precio" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                </div>
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Estado</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="Estado" id="estadoDisponible"
                           value="1" checked />
                    <label class="form-check-label" for="estadoDisponible">
                        Disponible
                    </label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio"
                           name="Estado" id="estadoNoDisponible"
                           value="2" />
                    <label class="form-check-label" for="estadoNoDisponible">
                        No Disponible
                    </label>
                </div>
                <span asp-validation-for="Estado" class="text-danger d-block"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Imagen del Combo</label>
                <input type="file" name="imagenFile" class="form-control" accept="image/*"
                       onchange="previsualizarImagen(this)" />
                <div class="mt-2">
                    <img id="previewImagen" src="#" alt="Vista previa"
                         style="max-width:200px; display:none; border-radius:8px;" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Productos del Combo</label>
                <small class="text-muted d-block mb-2">
                    Seleccione los productos e indique la cantidad de cada uno.
                </small>

                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Seleccionar</th>
                            <th>Producto</th>
                            <th>Precio Unitario</th>
                            <th style="width:120px;">Cantidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in listaProductos)
                        {
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox"
                                           name="productosSeleccionados"
                                           value="@producto.IdProducto"
                                           class="form-check-input chk-producto"
                                           onchange="toggleCantidad(this)" />
                                </td>
                                <td>@producto.Nombre</td>
                                <td>₡@producto.Precio.ToString("N2")</td>
                                <td>
                                    <input type="number"
                                           name="cantidad_@producto.IdProducto"
                                           value="1"
                                           min="1"
                                           max="99"
                                           class="form-control form-control-sm"
                                           disabled />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
                {
                    <span class="text-danger">
                        @ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage
                    </span>
                }
            </div>

            <div class="btn-group mt-3" role="group">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> Guardar
                </button>
                <button type="button" class="btn btn-secondary" onclick="history.back()">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCantidad(checkbox) {
            const fila = checkbox.closest('tr');
            const inputCantidad = fila.querySelector('input[type="number"]');
            inputCantidad.disabled = !checkbox.checked;
            if (!checkbox.checked) inputCantidad.value = 1;
        }

        function previsualizarImagen(input) {
            const preview = document.getElementById('previewImagen');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}