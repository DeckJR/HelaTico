@using Microsoft.Extensions.Localization
@using HelaTico.Web.Helpers
@using System.Security.Claims

@inject IStringLocalizerFactory LocalizerFactory

@{
    var SharedLocalizer =
        LocalizerFactory.Create(
            "Views.Shared.SharedResource",
            "HelaTico.Web");

    var cantidadCarrito =
        CarritoSessionHelper.ObtenerCantidadTotal(
            Context.Session);

    var idUsuarioLogueado =
        User.FindFirst(
            ClaimTypes.NameIdentifier)?.Value;
}

<style>

    .navbar-hela .nav-link {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .navbar-hela .dropdown-menu {
        background-color: #fdfbd4;
    }

    .navbar-hela .navbar-brand {
        font-weight: 700;
    }

    .usuario-menu-link {
        transition: opacity .2s ease;
    }

        .usuario-menu-link:hover {
            opacity: .8;
        }

</style>

<nav class="navbar navbar-expand-lg navbar-dark shadow navbar-hela"
     style="background:#0a4195;">

    <div class="container-fluid">

        <!-- LOGO -->

        <a class="navbar-brand d-flex align-items-center"
           href="@Url.Action("Index","Home")">

            <img src="~/images/logo.png"
                 alt="HelaTico"
                 style="width:44px;
                        height:44px;
                        border-radius:50%;
                        object-fit:cover;
                        margin-right:10px;
                        border:2px solid #fff;" />

            HelaTico

        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target=".navbar-collapse"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

            <ul class="navbar-nav flex-grow-1">

                <!-- HOME -->

                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">

                        @SharedLocalizer["NavInicio"]

                    </a>

                </li>

                <!-- PROCESOS -->

                <li class="nav-item dropdown">

                    <a class="nav-link dropdown-toggle"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        <i class="bi bi-arrow-repeat"></i>

                        @SharedLocalizer["NavProcesos"]

                    </a>

                    <ul class="dropdown-menu">

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Producto"
                               asp-action="ProductoCards">

                                @SharedLocalizer["NavProductosDisponibles"]

                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Combo"
                               asp-action="ComboCards">

                                @SharedLocalizer["NavCombos"]

                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Preparacion"
                               asp-action="Index">

                                @SharedLocalizer["NavProcesoPreparacion"]

                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Menu"
                               asp-action="MenusDisponibles">

                                @SharedLocalizer["NavMenusDisponibles"]

                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        @if (User.Identity != null &&
                        User.Identity.IsAuthenticated &&
                        User.IsInRole("Cocina"))
                        {
                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Orden"
                                   asp-action="Index">

                                    @SharedLocalizer["NavEstaciones"]

                                </a>

                            </li>
                        }

                    </ul>

                </li>

                <!-- MANTENIMIENTOS -->

                <li class="nav-item dropdown">

                    <a class="nav-link dropdown-toggle"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        <i class="bi bi-wrench"></i>

                        @SharedLocalizer["NavMantenimientos"]

                    </a>

                    <ul class="dropdown-menu">

                        <li>

                            <a class="dropdown-item"
                               asp-controller="Producto"
                               asp-action="Index">

                                @SharedLocalizer["NavProductos"]

                            </a>

                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>

                            <a class="dropdown-item"
                               asp-controller="Combo"
                               asp-action="Index">

                                @SharedLocalizer["NavCombos"]

                            </a>

                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>

                            <a class="dropdown-item"
                               asp-controller="Menu"
                               asp-action="Index">

                                @SharedLocalizer["NavMenus"]

                            </a>

                        </li>

                        @if (User.Identity != null &&
                        User.Identity.IsAuthenticated &&
                        User.IsInRole("Administrador"))
                        {
                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Usuario"
                                   asp-action="Index">

                                    @SharedLocalizer["NavUsuarios"]

                                </a>

                            </li>
                        }

                    </ul>

                </li>

                <!-- HISTORIAL -->
                @if (User.Identity != null &&
                User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Pedido"
                           asp-action="Historial">

                            <i class="bi bi-receipt"></i>

                            @SharedLocalizer["NavHistorialPedidos"]

                        </a>

                    </li>
                }

            </ul>



            <div class="d-flex align-items-center ms-auto">

                <!-- IDIOMA -->
                @{
                    var cultureFeature =
                    Context.Features.Get<
                    Microsoft.AspNetCore.Localization.IRequestCultureFeature>();

                    var currentCulture =
                    cultureFeature?.RequestCulture.Culture.Name ?? "es";
                }

                <form asp-controller="Culture"
                      asp-action="SetLanguage"
                      method="post"
                      class="d-flex align-items-center me-3">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="returnUrl"
                           value="@(Context.Request.Path + Context.Request.QueryString)" />

                    <select name="culture"
                            class="form-select form-select-sm w-auto"
                            onchange="this.form.submit()">

                        <option value="es"
                                selected="@(currentCulture == "es")">

                            Español

                        </option>

                        <option value="en"
                                selected="@(currentCulture == "en")">

                            English

                        </option>

                    </select>

                </form>

                <!-- CARRITO -->

                <a asp-controller="Carrito"
                   asp-action="Ver"
                   class="btn btn-outline-light btn-sm me-3 position-relative">

                    <i class="bi bi-cart3"></i>

                    <span id="badgeCarrito"
                          class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill">

                        @cantidadCarrito

                    </span>

                </a>

                @if (User.Identity != null &&
                User.Identity.IsAuthenticated)
                {
                    if (!string.IsNullOrWhiteSpace(idUsuarioLogueado))
                    {
                        <a asp-controller="Usuario"
                           asp-action="Edit"
                           asp-route-id="@idUsuarioLogueado"
                           class="text-white text-decoration-none fw-semibold me-3 usuario-menu-link">

                            <i class="bi bi-person-circle me-1"></i>

                            @User.Identity.Name

                        </a>
                    }
                    else
                    {
                        <span class="text-white me-3">

                            <i class="bi bi-person-circle me-1"></i>

                            @User.Identity.Name

                        </span>
                    }

                    <!-- LOGOUT -->

                    <form asp-controller="Login"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-light btn-sm">

                            @SharedLocalizer["btnLogout"]

                        </button>

                    </form>
                }
                else
                {
                    <a class="btn btn-outline-light btn-sm"
                       asp-controller="Login"
                       asp-action="Index">

                        @SharedLocalizer["btnLogIn"]

                    </a>
                }

            </div>

        </div>

    </div>

</nav>